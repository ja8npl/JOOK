# Vorlage — hier stehen nur die NAMEN der Variablen, niemals echte Werte.
# Die Werte liegen in Infisical (Projekt "jook"), nicht im Repo.
# Lokal: `npm run dev` (startet über `infisical run --env=dev`).
# Auf Vercel: über den Infisical-Vercel-Sync, nicht per Hand im Dashboard.

# Secret — wird ausschließlich serverseitig in api/parse-plan.ts gelesen (OpenRouter).
OPENROUTER_API_KEY=

# Optional — Ziel des Vite-Dev-Proxys für /api/*.
# Ohne Wert: https://gym-log-virid.vercel.app (Production-Deployment).
API_PROXY_TARGET=
